doctype html
html
  head
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 My Book Collection
    p
      a(href="/update-cobj") Add to this table
    table
      thead
        tr
          th Book Title
          th Author
          th Genre
      tbody
        each book in data
          tr
            td= book.properties.book_title
            td= book.properties.book_author
            td= book.properties.book_genre
